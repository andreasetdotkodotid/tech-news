NODE_ENV=production
BASE_PATH=/tech-and-security
PUBLIC_SITE_URL=https://news.dotko.id/tech-and-security
DATABASE_URL=postgresql://technews:change-me@postgres:5432/technews
POSTGRES_DB=technews
POSTGRES_USER=technews
POSTGRES_PASSWORD=change-me
SYNC_CRON=1 0 * * *
FALLBACK_CRON=1 */6 * * *
FETCH_TIMEOUT_MS=15000
NVD_LOOKBACK_DAYS=30
NVD_RESULTS_PER_PAGE=200
NVD_TIMEOUT_MS=60000
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
WEB_PORT=4321
